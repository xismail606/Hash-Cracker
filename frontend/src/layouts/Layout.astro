---
import "../styles/global.css";
import Navbar from "../components/Navbar.jsx";
import Footer from "../components/Footer.jsx";
import ParticleBackground from "../components/ParticleBackground.jsx";

// Shared page shell: head + theme init, fixed background layers, capsule
// navbar, and a full-height main column with the footer pinned to the bottom.
// Every page renders inside <main> via the default slot.
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08090c" id="meta-theme-color" />
    <!-- Theme init before paint to prevent FOUC (same approach as the Hash Cracker webpage) -->
    <script is:inline>
      (function () {
        const storedTheme = localStorage.getItem("theme");
        const isDark =
          storedTheme === "dark" ||
          (!storedTheme && !window.matchMedia("(prefers-color-scheme: light)").matches);
        document.documentElement.setAttribute("data-theme", isDark ? "dark" : "light");
        const metaTheme = document.getElementById("meta-theme-color");
        if (metaTheme) metaTheme.setAttribute("content", isDark ? "#08090c" : "#f2f4f8");
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-bg text-text">
    <div class="bg-grid" aria-hidden="true"></div>
    <ParticleBackground client:load />
    <Navbar client:load />
    <main class="mx-auto w-full max-w-6xl flex-1 px-4 pb-20 pt-28 sm:px-6">
      <slot />
    </main>
    <Footer client:load />
  </body>
</html>

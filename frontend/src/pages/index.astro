---
import Layout from "../layouts/Layout.astro";
import AuditDashboard from "../components/AuditDashboard.jsx";
import { CHANGELOG } from "../data/changelog.js";

const currentVersion = CHANGELOG[0]?.version;
---

<Layout
  title="Hash Cracker — Offline Password Audit"
  description="Local, offline password-hash auditing with dictionary and bounded brute-force modes, live progress, and SQLite history."
>
  <header class="mb-12">
    <span
      class="mono mb-4 inline-block rounded-md border border-border bg-surface px-2 py-1 text-xs font-semibold text-text-muted"
    >
      {currentVersion}
    </span>
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <h1 class="hero-title">Hash Cracker</h1>
        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-text-muted sm:text-base">
          Audit password hashes you control on this machine: dictionary or
          bounded brute-force comparison against MD5, SHA-256, and NTLM, run by
          a multiprocessing engine and recorded in local SQLite history. The
          server binds to <span class="mono text-text">127.0.0.1</span> and
          never sends hashes, candidates, or results over the network.
        </p>
      </div>
      <div class="grid shrink-0 grid-cols-2 gap-3 lg:w-80">
        <div
          class="rounded-2xl border border-border bg-surface/70 px-4 py-3 backdrop-blur-sm transition-colors hover:border-accent/30"
        >
          <p class="mono text-xl font-bold text-accent">23</p>
          <p
            class="mt-0.5 text-[11px] font-semibold uppercase tracking-wider text-text-muted"
          >
            Hash formats
          </p>
        </div>
        <div
          class="rounded-2xl border border-border bg-surface/70 px-4 py-3 backdrop-blur-sm transition-colors hover:border-accent/30"
        >
          <p class="mono text-xl font-bold text-accent">2</p>
          <p
            class="mt-0.5 text-[11px] font-semibold uppercase tracking-wider text-text-muted"
          >
            Audit modes
          </p>
        </div>
        <div
          class="rounded-2xl border border-border bg-surface/70 px-4 py-3 backdrop-blur-sm transition-colors hover:border-accent/30"
        >
          <p class="mono text-xl font-bold text-accent">1–8</p>
          <p
            class="mt-0.5 text-[11px] font-semibold uppercase tracking-wider text-text-muted"
          >
            Workers
          </p>
        </div>
        <div
          class="rounded-2xl border border-border bg-surface/70 px-4 py-3 backdrop-blur-sm transition-colors hover:border-accent/30"
        >
          <p class="mono text-xl font-bold text-accent">100%</p>
          <p
            class="mt-0.5 text-[11px] font-semibold uppercase tracking-wider text-text-muted"
          >
            Offline
          </p>
        </div>
      </div>
    </div>
  </header>
  <AuditDashboard client:load />
</Layout>
